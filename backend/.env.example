# ------------------------------------------------------------------
# Environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Runtime environment: development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# MySQL DSN (PyMySQL driver). https://docs.sqlalchemy.org/en/20/dialects/mysql.html
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/supply_chain?charset=utf8mb4

# Optional separate database used by integration tests.
TEST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/supply_chain_test?charset=utf8mb4

# Connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# JWT (used from Stage 2 onward; required now to keep config stable)
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins.
# Production must list the real frontend origin, never `*`.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Production requires a non-root remote MySQL account, strong JWT secret,
# exact HTTPS frontend CORS origins, and verified database TLS.
DB_REQUIRE_TLS=true
# Optional provider CA certificate path (system trust is used otherwise).
# DB_SSL_CA=/run/secrets/mysql-ca.pem
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_WRITE_TIMEOUT=15
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
LOGIN_RATE_LIMIT=10
TRACKING_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
